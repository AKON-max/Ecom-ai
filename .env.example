# Ecom-ai runtime configuration
AGENT_OPENAI_API_KEY=your-api-key
AGENT_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
AGENT_OPENAI_MODEL=Qwen/Qwen3-8B
AGENT_CLASSIFIER_MODEL=Qwen/Qwen3-8B
AGENT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
AGENT_RAG_RERANK_ENABLED=true
AGENT_RAG_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
AGENT_RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1

# Local service topology
ECOMMERCE_BASE_URL=http://localhost:8081
AGENT_SERVICE_AUTH_TOKEN=replace-with-a-local-service-token
MYSQL_DATABASE=ecom_ai
MYSQL_ROOT_PASSWORD=replace-with-a-local-password

# Optional offline mode for deterministic tests
AGENT_OFFLINE_RAG=0
AGENT_OFFLINE_FACTS=0
AGENT_DISABLE_LLM=0